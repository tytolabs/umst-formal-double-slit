theorem madelung_electrons_check : (List.range 119).all (fun z => electrons (madelung z) == z) = true := by
  decide

/-- Every Madelung configuration for Z ≤ 118 holds exactly Z electrons. -/
theorem madelung_electrons (z : Nat) (hz : z ≤ 118) : electrons (madelung z) = z := by
  have h := List.all_eq_true.mp madelung_electrons_check z (List.mem_range.mpr (by omega))
  simpa using h

theorem madelung_withinCapacity_check : (List.range 119).all (fun z => withinCapacity (madelung z)) = true := by
  decide

/-- No Madelung configuration for Z ≤ 118 puts more than 2(2ℓ + 1) electrons in a subshell. -/
theorem madelung_withinCapacity (z : Nat) (hz : z ≤ 118) : withinCapacity (madelung z) = true :=
  List.all_eq_true.mp madelung_withinCapacity_check z (List.mem_range.mpr (by omega))

theorem observed_atomic_numbers : observed.map Prod.fst = List.range' 1 103 := by
  decide

theorem observed_electrons : observed.all (fun e => electrons e.2 == e.1) = true := by
  decide

theorem observed_withinCapacity : observed.all (fun e => withinCapacity e.2) = true := by
  decide

/-- The elements whose cited ground state differs from the Madelung prediction. -/
theorem madelung_exceptions :
    (observed.filter fun e => e.2 != madelung e.1).map Prod.fst =
      [24, 29, 41, 42, 44, 45, 46, 47, 57, 58, 64, 78, 79, 89, 90, 91, 92, 93, 96, 103] := by
  decide

end UMST.Chem.GroundStates
