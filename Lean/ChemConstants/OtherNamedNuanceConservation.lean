/-- Class-24 other_named_nuance concurrent **product** bundle (north-star §3). -/
structure OtherNamedNuanceConcurrentBundle where
  channelSlots : List OtherNamedNuanceChannelSlot
  deriving DecidableEq, Repr

/-- All channels Unwired — honest scaffold baseline. -/
def otherNamedNuanceConcurrentBundleUnwired : OtherNamedNuanceConcurrentBundle :=
  { channelSlots := List.replicate otherNamedNuanceProductChannelCount .unwired }

def otherNamedNuanceConcurrentBundleWithChannel (idx : Nat) (slot : OtherNamedNuanceChannelSlot)
    (b : OtherNamedNuanceConcurrentBundle) : OtherNamedNuanceConcurrentBundle :=
  if idx < b.channelSlots.length then
    { channelSlots :=
        b.channelSlots.take idx ++ [slot] ++ b.channelSlots.drop (idx + 1) }
  else b

def otherNamedNuanceConcurrentBundleWithPresent (idx : Nat) (b : OtherNamedNuanceConcurrentBundle) :
    OtherNamedNuanceConcurrentBundle :=
  otherNamedNuanceConcurrentBundleWithChannel idx .present b

def otherNamedNuanceConcurrentBundleChannelAt (idx : Nat) (b : OtherNamedNuanceConcurrentBundle) :
    Option OtherNamedNuanceChannelSlot :=
  b.channelSlots.get? idx

def otherNamedNuanceConcurrentBundleHolds (idx : Nat) (b : OtherNamedNuanceConcurrentBundle) : Bool :=
  match otherNamedNuanceConcurrentBundleChannelAt idx b with
  | some .present => true
  | _ => false

def otherNamedNuanceConcurrentBundlePresentCount (b : OtherNamedNuanceConcurrentBundle) : Nat :=
  b.channelSlots.foldl (fun acc s => if otherNamedNuanceChannelSlotIsPresent s then acc + 1 else acc) 0

def otherNamedNuanceConcurrentBundleIsConcurrentProduct (b : OtherNamedNuanceConcurrentBundle) : Bool :=
  decide (otherNamedNuanceConcurrentBundlePresentCount b ≥ 2)

