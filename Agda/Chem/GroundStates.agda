allᵇ : {A : Set} → (A → Bool) → List A → Bool
allᵇ p = foldr (λ x acc → p x ∧ acc) true

Subshell : Set
Subshell = ℕ × ℕ

Occupancy : Set
Occupancy = ℕ × ℕ × ℕ

capacity : Subshell → ℕ
capacity (_ , l) = 2 * (2 * l + 1)

madelungRank : Subshell → ℕ
madelungRank (n , l) = (n + l) * 8 + n

madelungOrder : List Subshell
madelungOrder = (1 , 0) ∷ (2 , 0) ∷ (2 , 1) ∷ (3 , 0) ∷ (3 , 1) ∷ (4 , 0) ∷ (3 , 2) ∷ (4 , 1) ∷ (5 , 0) ∷ (4 , 2) ∷ (5 , 1) ∷ (6 , 0) ∷ (4 , 3) ∷ (5 , 2) ∷ (6 , 1) ∷ (7 , 0) ∷ (5 , 3) ∷ (6 , 2) ∷ (7 , 1) ∷ (6 , 3) ∷ (7 , 2) ∷ (7 , 3) ∷ []

sortedᵇ : List Subshell → Bool
sortedᵇ (a ∷ b ∷ rest) = (madelungRank a <ᵇ madelungRank b) ∧ sortedᵇ (b ∷ rest)
sortedᵇ _ = true

madelungOrder-sorted : sortedᵇ madelungOrder ≡ true
madelungOrder-sorted = refl

fill : List Subshell → ℕ → List Occupancy
fill [] _ = []
fill (_ ∷ _) zero = []
fill ((n , l) ∷ rest) (suc z) = (n , l , k) ∷ fill rest (suc z ∸ k)
  where k = capacity (n , l) ⊓ suc z

madelung : ℕ → List Occupancy
madelung = fill madelungOrder

electrons : List Occupancy → ℕ
electrons = foldr (λ x acc → proj₂ (proj₂ x) + acc) 0

withinCapacity : List Occupancy → Bool
withinCapacity = allᵇ (λ where (n , l , k) → k ≤ᵇ capacity (n , l))

configᵇ : List Occupancy → List Occupancy → Bool
configᵇ [] [] = true
configᵇ ((n₁ , l₁ , k₁) ∷ r₁) ((n₂ , l₂ , k₂) ∷ r₂) = (n₁ ≡ᵇ n₂) ∧ (l₁ ≡ᵇ l₂) ∧ (k₁ ≡ᵇ k₂) ∧ configᵇ r₁ r₂
configᵇ _ _ = false

